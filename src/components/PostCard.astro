---
interface Props {
  title: string;
  slug: string;
  date: string;
  excerpt?: string;
}

const { title, slug, date, excerpt } = Astro.props;
---

<article class="post-card">
  <h2 class="post-title">
    <a class="post-link" href={`/posts/${slug}`}>
      {title}
    </a>
  </h2>
  <div class="post-meta">
    {excerpt && <div class="post-excerpt">{excerpt}</div>}
    <div class="post-footer">
      <a class="read-more" href={`/posts/${slug}`}>阅读全文</a>
      <span class="post-date">{date}</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    padding: 2rem;
    margin-bottom: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .post-card:hover {
    background-color: var(--color-surface);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(123, 136, 161, 0.08);
    border-color: rgba(123, 136, 161, 0.1);
  }

  .post-card:last-child {
    margin-bottom: 0;
  }

  .post-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  .post-link {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-serif);
    transition: color 0.2s ease;
  }

  .post-link:hover {
    color: var(--color-accent);
  }

  .post-meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-excerpt {
    margin-top: 0.5rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
  }

  .read-more {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    transition: color 0.2s ease;
  }

  .read-more:hover {
    color: var(--color-text);
  }

  .post-date {
    font-size: 0.8rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
</style>

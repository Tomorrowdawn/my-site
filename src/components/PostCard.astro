---
interface Props {
  title: string;
  slug: string;
  date: string;
  excerpt?: string;
}

const { title, slug, date, excerpt } = Astro.props;
---

<article class="post-card">
  <h2 class="post-title">
    <a class="post-link" href={`/posts/${slug}`}>
      {title}
    </a>
  </h2>
  <div class="post-meta">
    {excerpt && <div class="post-excerpt">{excerpt}</div>}
    <div class="post-footer">
      <a class="read-more" href={`/posts/${slug}`}>阅读全文……</a>
      <span class="post-date">{date}</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  .post-link {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-serif);
    transition: color 0.2s ease;
  }

  .post-link:hover {
    color: var(--color-accent);
  }

  .post-meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-excerpt {
    margin-top: 0.5rem;
    line-height: 1.8;
    color: #4b5563;
    font-size: 0.9rem;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
  }

  .read-more {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.825rem;
    font-family: var(--font-sans);
    transition: color 0.2s ease;
  }

  .read-more:hover {
    color: var(--color-link-hover);
  }

  .post-date {
    font-size: 0.8rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
</style>

---
interface Props {
  current?: string;
}

const { current = "all" } = Astro.props;

const categories = [
  { id: "all", label: "All" },
  { id: "math", label: "Math" },
  { id: "philosophy", label: "Philosophy" },
  { id: "code", label: "Code" },
];

// 使用 Astro 内置的 base 路径，避免硬编码
const base = import.meta.env.BASE_URL || "/";
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
---

<nav class="category-tabs" aria-label="Post categories">
  {categories.map(cat => (
    <a
      href={cat.id === "all" ? normalizedBase : `${normalizedBase}?category=${cat.id}`}
      class:list={["tab", { active: current === cat.id }]}
      aria-current={current === cat.id ? "page" : undefined}
      data-feeds-link
    >
      {cat.label}
    </a>
  ))}
</nav>

<style>
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tab {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    transition: color 0.2s ease;
    position: relative;
  }

  .tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1rem;
    height: 2px;
    background: transparent;
    transition: background 0.2s ease;
  }

  .tab:hover {
    color: var(--color-text);
  }

  .tab.active {
    color: var(--color-text);
    font-weight: 600;
  }

  .tab.active::after {
    background: var(--color-accent);
  }

  .tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>


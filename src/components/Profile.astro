---
interface Props {
  avatar?: string;
  name?: string;
  bio?: string;
}

interface LinkItem {
  icon: "github" | "zhihu";
  url: string;
  label: string;
}

interface SvgIcons {
  github: string;
  zhihu: string;
}

const {
  avatar = "/avatar.jpg",
  name = "TomorrowDawn"
} = Astro.props;


const links: LinkItem[] = [
  {
    icon: "github",
    url: "https://github.com/tomorrowdawn",
    label: "GitHub"
  },
  {
    icon: "zhihu",
    url: "https://www.zhihu.com/people/zhinvcni",
    label: "知乎"
  },
];

const svgIcons: SvgIcons = {
  github: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
  </svg>`,
  zhihu: `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="font-family: sans-serif;">
    <text x="12" y="14" text-anchor="middle" font-size="14" font-weight="bold">知</text>
  </svg>`,
};
---

<aside class="profile">
  <div class="avatar">
    <img src={avatar} alt={name} />
  </div>
  <h3 class="name">{name}</h3>
  <div class="bio">
    <p set:html={`If you <em>don't have time</em> to do something, it's actually that you <strong>don't want</strong> to do it.`} />
    <p set:html={`If you <em>don't know what</em> to do, you're actually doing <strong>anxiety</strong>.`} />
    <p set:html={`If you don't know when you can announce to others "<em>I'm done, goodbye</em>", then you'll either <strong>never start or never finish</strong>.`} />
  </div>
  <div class="links">
    <div class="link-icons">
      {links.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" title={link.label}>
          <span set:html={svgIcons[link.icon]} />
          <span class="link-label">{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</aside>

<style>
  .profile {
    width: var(--sidebar-width);
    padding: 2.5rem 2rem 2.5rem 0;
    position: sticky;
    top: 4rem;
    align-self: flex-start;
  }

  .avatar {
    width: 100px;
    height: 100px;
    margin: 0 auto 1.25rem;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(123, 136, 161, 0.15);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .bio {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    padding: 0 0.5rem;
  }

  .bio p {
    margin: 0.5rem 0;
  }

  .bio p:first-child {
    margin-top: 0;
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  .bio em {
    font-style: normal;
    color: var(--color-text-muted);
  }

  .bio strong {
    font-weight: 500;
    color: var(--color-text);
  }

  .link-icons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link-icons a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-family: var(--font-sans);
    transition: all 0.2s;
  }

  .link-icons a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .link-icons svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .link-label {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .profile {
      width: 100%;
      padding: 2rem 0 1rem;
      position: static;
      top: auto;
    }

    .link-icons {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>

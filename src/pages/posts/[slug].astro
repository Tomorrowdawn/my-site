---
import BaseLayout from "@layouts/BaseLayout.astro";
import Nav from "@components/Nav.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = "https://blog.tomorrowdawn.cc";
const postUrl = `${siteUrl}/posts/${post.slug}`;
const blogPostingJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "datePublished": post.data.createdAt,
  "author": {
    "@type": "Person",
    "name": "唐晨夏",
    "alternateName": ["TomorrowDawn"],
    "url": siteUrl,
  },
  "image": `${siteUrl}/avatar.jpg`,
  "url": postUrl,
});
---

<BaseLayout title={`${post.data.title} | 唐晨夏的博客`} type="article" url={postUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={blogPostingJsonLd} />
  </Fragment>
  <Nav />
  <main class="container">
    <article class="post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.createdAt}>{post.data.createdAt}</time>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>
      <div class="post-content">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-size: 1.75rem;
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: #f3f4f6;
    border-radius: 3px;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-content {
    line-height: 1.9;
    font-size: 1rem;
  }

  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    color: var(--color-text);
  }

  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(ol) {
    list-style-type: decimal;
  }

  .post-content :global(ul) {
    list-style-type: disc;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(75, 101, 132, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .post-content :global(th) {
    background: #f3f4f6;
    font-weight: 600;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 2rem 1.25rem;
    }

    .post-header h1 {
      font-size: 1.5rem;
    }
  }
</style>

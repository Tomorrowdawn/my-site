---
import BaseLayout from "@layouts/BaseLayout.astro";
import Nav from "@components/Nav.astro";
import Profile from "@components/Profile.astro";
import CategoryTabs from "@components/CategoryTabs.astro";

const url = new URL(Astro.request.url);
const category = url.searchParams.get("category") || "all";
---

<BaseLayout
  title="唐晨夏的博客 | TomorrowDawn's Blog"
  description="唐晨夏（TomorrowDawn）的个人博客，USTC中科大毕业生，分享数学、哲学与编程的思考"
>
  <Nav />
  <main class="container">
    <Profile />
    <section class="feed">
      <div class="feed-panel">
        <CategoryTabs current={category} />
        <div class="posts">
          <p class="loading">Loading posts...</p>
        </div>
      </div>
      <div class="pagination-container"></div>
    </section>
  </main>
  <script src="../scripts/feedsManager.ts"></script>
</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 0;
    padding: 0 2rem;
  }

  .feed {
    flex: 1;
    min-width: 0;
    padding: 2.5rem 0 2.5rem 3rem;
  }

  .feed-panel {
    background: transparent;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    border: none;
  }

  .posts {
    margin-top: 0.5rem;
  }

  .loading,
  :global(.no-posts) {
    color: var(--color-text-muted);
    padding: 2rem 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  :global(.post-card) {
    padding: 2rem;
    margin-bottom: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  :global(.post-card:hover) {
    background-color: var(--color-surface);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(123, 136, 161, 0.08);
    border-color: rgba(123, 136, 161, 0.1);
  }

  :global(.post-card:last-child) {
    margin-bottom: 0;
  }

  :global(.post-title) {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  :global(.post-link) {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-serif);
    transition: color 0.2s ease;
  }

  :global(.post-link:hover) {
    color: var(--color-accent);
  }

  :global(.post-meta) {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  :global(.post-excerpt) {
    margin-top: 0.5rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  :global(.post-footer) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
  }

  :global(.read-more) {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    transition: color 0.2s ease;
  }

  :global(.read-more:hover) {
    color: var(--color-text);
  }

  :global(.pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2.5rem 0;
    margin-top: 1rem;
  }

  :global(.page-link) {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    transition: all 0.2s;
    text-decoration: none;
  }

  :global(.page-link:hover) {
    background: var(--color-text);
    color: white;
    border-color: var(--color-text);
  }

  :global(.page-info) {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
      padding: 0 1.25rem;
    }

    .feed {
      padding: 1.5rem 0;
    }
  }
</style>

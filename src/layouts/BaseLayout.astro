---
interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
}

const siteUrl = "https://blog.tomorrowdawn.cc";
const {
  title,
  description = "唐晨夏的个人博客",
  image = "/avatar.jpg",
  url,
  type = "website",
} = Astro.props;

const canonicalUrl = url ? new URL(url, siteUrl).href : new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = image.startsWith("http") ? image : new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="唐晨夏" />
    <meta name="keywords" content="唐晨夏, USTC, 中科大, 中国科学技术大学, TomorrowDawn, 数学, 哲学, 编程, 博客" />
    <link rel="icon" type="image/jpeg" href="/fav.jpg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="唐晨夏的博客" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "唐晨夏的博客",
          "url": siteUrl,
          "author": { "@id": `${siteUrl}/#person` },
          "description": "数学、哲学与编程的思考空间",
        },
        {
          "@type": "Person",
          "@id": `${siteUrl}/#person`,
          "name": "唐晨夏",
          "alternateName": ["TomorrowDawn", "唐晨夏 USTC"],
          "url": siteUrl,
          "alumniOf": {
            "@type": "Organization",
            "name": "中国科学技术大学",
            "alternateName": ["USTC", "中科大"],
          },
          "sameAs": [
            "https://github.com/TomorrowDAW",
            "https://www.zhihu.com/people/zhinvcni",
            "https://www.linkedin.com/in/%E5%94%90%E6%99%A8%E5%A4%8F114514191/",
          ],
        },
      ],
    })} />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #f9fafb;
    --color-text: #111827;
    --color-text-muted: #6b7280;
    --color-border: #e5e7eb;
    --color-accent: #4b6584;
    --color-link: #4b6584;
    --color-link-hover: #2c3e50;
    --font-serif: "Noto Serif SC", "Georgia", serif;
    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: "JetBrains Mono", "SF Mono", monospace;
    --max-width: 1100px;
    --sidebar-width: 260px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-link-hover);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: #f3f4f6;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: #374151;
  }

  pre {
    background: #f3f4f6;
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  blockquote {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    position: relative;
    color: var(--color-text-muted);
    font-style: italic;
    border-left: 2px solid var(--color-accent);
  }

  ::selection {
    background: rgba(75, 101, 132, 0.15);
  }
</style>
